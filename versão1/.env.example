# Modelo de configuração da ferramenta Text-to-SQL.
# Copie para ".env" (na mesma pasta do server.js) e ajuste se necessário.
# O servidor lê este arquivo na inicialização; sem ele, usa os padrões abaixo.
#
# ATENÇÃO: não coloque senhas nem credenciais aqui — a conexão com o Firebird
# (usuário e senha) é informada na tela e fica somente na memória do servidor.

# Porta em que a ferramenta responde (http://localhost:PORT)
PORT=3000

# Endereço do serviço Ollama local
OLLAMA_BASE_URL=http://localhost:11434

# Modelo pré-selecionado no campo "Modelo no Ollama" da interface. A lista já
# oferece sqlcoder:7b e sqlcoder:15b; outro nome informado aqui é acrescentado.
# (confirme o nome instalado com: ollama list)
OLLAMA_MODEL=sqlcoder:7b

# Limite de linhas devolvidas por execução de consulta
MAX_ROWS=200

# Janela de contexto do modelo, em tokens (prompt + resposta). O que passar disso
# é descartado pelo Ollama sem aviso. Valores maiores usam mais memória e deixam a
# geração mais lenta. Esquemas grandes: desmarque tabelas antes de aumentar.
OLLAMA_NUM_CTX=8192

# Modelo de uso geral que sugere as descrições de tabelas e colunas (botão
# "Interpretar com IA"). Precisa estar instalado: ollama pull gemma4:e4b
DESC_MODEL=gemma4:e4b

# Linhas lidas de cada tabela para a IA entender os valores (máximo 200)
SAMPLE_ROWS=20

# true = não lê valores de colunas com dado pessoal (CPF, e-mail, telefone...).
# Pode ser false com banco fictício; mantenha true com banco real (LGPD).
DESC_MASK_SENSITIVE=true

# Diagnóstico: true grava o último prompt e a resposta bruta de cada modelo em
# versão1/debug/. Contém esquema e pergunta: use só com banco de teste.
DEBUG_PROMPT=false
